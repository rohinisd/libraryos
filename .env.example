# Local dev default (matches docker-compose.yml). Swap for the Neon connection
# string later — same Postgres wire protocol, no code changes needed.
DATABASE_URL="postgresql://libraryos:libraryos@localhost:5432/libraryos?schema=public"

# Session signing secret. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-change-me"

# Separate signing secret for the /platform (LibraryOS operator) session —
# deliberately not the same value as AUTH_SECRET so a leak of one doesn't
# compromise the other identity space.
PLATFORM_AUTH_SECRET="dev-only-platform-secret-change-me"

# Public base URL.
# Pinned to 4200 (not 3000) since this machine has another local project that
# fights over the default port.
NEXT_PUBLIC_APP_URL="http://localhost:4200"

# --- Not needed for local dev, wire up once the real accounts exist ---
# RESEND_API_KEY=
# BLOB_READ_WRITE_TOKEN=

# Encrypts student phone + Aadhaar in the database (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up safely; losing or changing it makes existing encrypted data unrecoverable.
FIELD_ENCRYPTION_KEY=""
